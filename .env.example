# No incluir valores reales en este archivo ni en el repositorio.
# Se configurarán recién en las etapas que necesiten cada servicio.
INMO_ENV=development
INMO_LOG_LEVEL=INFO

# Backend solamente. Nunca exponer una clave de servicio en frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conectores: conservar vacíos hasta disponer de autorización y credenciales.
MAPAPROP_API_BASE_URL=
MAPAPROP_API_KEY=
